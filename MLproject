name: mibici-equipo28

python_env: python_env.yaml

entry_points:
  load:
    command: "python -m mibici.dataset run-pipeline"

  workflow:
    command: "python -m mibici.workflow"

  # P1: regresión de salidas por estación-hora (solo train/validation).
  p1_train:
    command: "python -m mibici.modeling.mlflow_runs p1"

  # P2: catálogo de capacidades, etiquetas proxy y clasificadores.
  p2_catalog:
    command: "python -m mibici.modeling.p2_catalog"

  p2_targets:
    command: "python -m mibici.modeling.p2_targets"

  p2_train:
    command: "python -m mibici.modeling.mlflow_runs p2"

