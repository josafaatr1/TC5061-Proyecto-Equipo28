# Copia este archivo como .env y ajusta los valores locales.
# .env está en .gitignore: nunca subas credenciales al repositorio.

# Experimento de MLflow del equipo
MLFLOW_EXPERIMENT_NAME=mibici-equipo28

# Servidor de tracking (sección 7.2 del README)
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Solo si se usa un servidor remoto con autenticación (no definir aquí valores reales)
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=
